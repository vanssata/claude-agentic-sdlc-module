{
  "description": "RiskRails guards for Codex. The installer merges these entries into ~/.codex/hooks.json without duplicating a command. Codex requires you to review and trust a non-managed hook before it runs: open /hooks once after installing, or these are listed and skipped.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I -S \"$HOME/.codex/hooks/ai-guard.py\"",
            "timeout": 15,
            "statusMessage": "Checking git, paths, scope and open decisions"
          }
        ]
      },
      {
        "matcher": "^Agent$|spawn_agent$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.codex/hooks/runtime-gate.py\"",
            "timeout": 5,
            "statusMessage": "Checking expert-model availability"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^Agent$|spawn_agent$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.codex/hooks/runtime-gate.py\"",
            "timeout": 5,
            "statusMessage": "Recording expert-model availability"
          }
        ]
      },
      {
        "matcher": "^request_user_input$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I -S \"$HOME/.codex/hooks/dialog-gate.py\"",
            "timeout": 5,
            "statusMessage": "Recording the dialog's answer"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.codex/hooks/runtime-gate.py\"",
            "timeout": 5,
            "statusMessage": "Counting running agents"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.codex/hooks/runtime-gate.py\"",
            "timeout": 5,
            "statusMessage": "Recording expert-model availability"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.codex/hooks/context-guard.py\"",
            "timeout": 5,
            "statusMessage": "Measuring the session context"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.codex/hooks/context-guard.py\"",
            "timeout": 15,
            "statusMessage": "Writing the handoff before compaction"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.codex/hooks/context-guard.py\"",
            "timeout": 15,
            "statusMessage": "Reading the task in flight"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I -S \"$HOME/.codex/hooks/dialog-gate.py\"",
            "timeout": 5,
            "statusMessage": "Checking for an open decision"
          }
        ]
      }
    ]
  }
}
