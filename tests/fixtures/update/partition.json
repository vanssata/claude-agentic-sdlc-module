  "find_block": "D3: not moved and not re-exported; blocks.py calls render_instructions.find_block, and tests/test_regenerate.py imports render_instructions for it"
 },
 "moves": [
  {
   "names": [
    "report"
   ],
   "from": "report (layer 6)",
   "to": "report (layer 5)",
   "why": "cli imports report, so report sits one layer below cli; report refers to no other name of the file"
  },
  {
   "names": [
    "tomllib"
   ],
   "from": "not placed in the plan's table",
   "to": "kept",
   "why": "the `try: import tomllib` result is read by check_kept alone; kept.py holds the try, so no other module imports tomllib"
  },
  {
   "names": [
    "find_block"
   ],
   "from": "paths (the table's constants list)",
   "to": "retired",
   "why": "D3: the alias `render_instructions.find_block` is dropped; block_update calls render_instructions.find_block, so the edge to it is a sibling module, not a rr_update module"
  },
  {
   "names": [
    "plan"
   ],
   "from": "plan (core)",
   "to": "plan (mixed: Plan and regenerate are shell, lost_lines, patterns_of, edited_note core)",
   "why": "Plan reads the disk (exists, read, before) and the clock (report_dir); regenerate calls plan.read; so the module is not all-core and R16's import rule does not bind it"
  },
  {
   "names": [
    "paths"
   ],
   "from": "paths (core + constants)",
   "to": "paths (mixed: env, HERE, SKILLS, TEMPLATES, HISTORY, PLUGIN_HOME, SHARED shell; the literal tables and is_kept core)",
   "why": "env reads the environment, HERE is __file__, SHARED probes directories at import (D1, D2); the module imports os for them"
  },
  {
   "names": [
    "verification_hints",
    "regenerate",
    "unwritten"
   ],
   "from": "core / core / core by the table",
   "to": "shell",
   "why": "each calls plan.read or plan.exists, which read the disk"
  }
 ],
