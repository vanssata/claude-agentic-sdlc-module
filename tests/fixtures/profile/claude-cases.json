{
  "_doc": "state.py profile detect --runtime claude. account is ~/.claude.json (null: no file); installed is <home>/riskrails/profile.json (null: none); env is added to a clean environment. The first nine cases are tests/test_install_dry_run.py:225-285 verbatim; the three non-string cases pin JS String() (review T-2026-10-28-002 L1); plan and from are what the installer printed for them.",
  "cases": [
    {"name": "claude_team with no seat", "account": {"oauthAccount": {"organizationType": "claude_team"}},
     "installed": {"plan": "team-pro"}, "expect": {"status": "unknown", "plan": null, "from": "team", "org": "claude_team"}},
    {"name": "a standard seat", "account": {"oauthAccount": {"organizationType": "claude_team", "seatTier": "standard"}},
     "installed": {"plan": "team-pro"}, "expect": {"status": "same", "plan": "team-pro", "from": "claude_team, seat 'standard'", "org": "claude_team"}},
    {"name": "a premium seat", "account": {"oauthAccount": {"organizationType": "claude_team", "seatTier": "premium"}},
     "installed": {"plan": "team-max"}, "expect": {"status": "same", "plan": "team-max", "from": "claude_team, seat 'premium'", "org": "claude_team"}},
    {"name": "a team org with a max rate-limit tier", "account": {"oauthAccount": {"organizationType": "claude_team", "organizationRateLimitTier": "default_claude_max_5x"}},
     "installed": {"plan": "team-max"}, "expect": {"status": "same", "plan": "team-max", "from": "claude_team, seat 'default_claude_max_5x'", "org": "claude_team"}},
    {"name": "claude_max", "account": {"oauthAccount": {"organizationType": "claude_max"}},
     "installed": {"plan": "max"}, "expect": {"status": "same", "plan": "max", "from": "organizationType claude_max", "org": "claude_max"}},
    {"name": "default_claude_max_20x", "account": {"oauthAccount": {"organizationType": "claude_max", "organizationRateLimitTier": "default_claude_max_20x"}},
     "installed": {"plan": "max20"}, "expect": {"status": "same", "plan": "max20", "from": "organizationRateLimitTier default_claude_max_20x", "org": "claude_max"}},
    {"name": "default_claude_max_5x stays max", "account": {"oauthAccount": {"organizationType": "claude_max", "organizationRateLimitTier": "default_claude_max_5x"}},
     "installed": {"plan": "max"}, "expect": {"status": "same", "plan": "max", "from": "organizationType claude_max, default_claude_max_5x", "org": "claude_max"}},
    {"name": "claude_pro", "account": {"oauthAccount": {"organizationType": "claude_pro"}},
     "installed": {"plan": "pro"}, "expect": {"status": "same", "plan": "pro", "from": "organizationType claude_pro", "org": "claude_pro"}},
    {"name": "organizationType outside oauthAccount", "account": {"organizationType": "claude_max"},
     "installed": {"plan": "max"}, "expect": {"status": "same", "plan": "max", "from": "organizationType claude_max", "org": "claude_max"}},
    {"name": "a non-string org is String()ed as JS did: an object", "account": {"oauthAccount": {"organizationType": {"a": "max"}}},
     "installed": {"plan": "max"}, "expect": {"status": "unknown", "plan": null, "from": null, "org": "[object Object]"}},
    {"name": "a non-string seat is String()ed as JS did: a list", "account": {"oauthAccount": {"organizationType": "claude_team", "seatTier": ["max"]}},
     "installed": {"plan": "team-max"}, "expect": {"status": "same", "plan": "team-max", "from": "claude_team, seat 'max'", "org": "claude_team"}},
    {"name": "a non-string tier is String()ed as JS did: a float", "account": {"oauthAccount": {"organizationType": "claude_max", "organizationRateLimitTier": 1.0}},
     "installed": {"plan": "max"}, "expect": {"status": "same", "plan": "max", "from": "organizationType claude_max, 1", "org": "claude_max"}},
    {"name": "balanced-max installed on a max20 account", "account": {"oauthAccount": {"organizationType": "claude_max", "organizationRateLimitTier": "default_claude_max_20x"}},
     "installed": {"plan": "balanced-max"}, "expect": {"status": "same", "plan": "max20"}},
    {"name": "balanced-max installed on a max account", "account": {"oauthAccount": {"organizationType": "claude_max"}},
     "installed": {"plan": "balanced-max"}, "expect": {"status": "same", "plan": "max"}},
    {"name": "no oauthAccount", "account": {"numStartups": 3},
     "installed": {"plan": "max"}, "expect": {"status": "unknown", "plan": null, "from": null, "org": ""}},
    {"name": "no ~/.claude.json", "account": null,
     "installed": {"plan": "max"}, "expect": {"status": "unknown", "plan": null}},
    {"name": "an API key and no oauthAccount", "account": {"numStartups": 3}, "env": {"ANTHROPIC_API_KEY": "sk-test-not-a-key"},
     "installed": {"plan": "max"}, "expect": {"status": "unsupported", "plan": null}},
    {"name": "Bedrock and no oauthAccount", "account": null, "env": {"CLAUDE_CODE_USE_BEDROCK": "1"},
     "installed": {"plan": "max"}, "expect": {"status": "unsupported", "plan": null}},
    {"name": "Vertex and no oauthAccount", "account": null, "env": {"CLAUDE_CODE_USE_VERTEX": "1"},
     "installed": {"plan": "max"}, "expect": {"status": "unsupported", "plan": null}},
    {"name": "no installed profile", "account": {"oauthAccount": {"organizationType": "claude_max"}},
     "installed": null, "expect": {"status": "no_profile", "plan": "max"}},
    {"name": "max installed, max20 account: same tier", "account": {"oauthAccount": {"organizationType": "claude_max", "organizationRateLimitTier": "default_claude_max_20x"}},
     "installed": {"plan": "max", "plugin_version": "3.1.0"},
     "expect": {"status": "drift", "plan": "max20", "render": "profile", "command_has": "profile set max20 --runtime claude"}},
    {"name": "pro installed, max account: across tiers", "account": {"oauthAccount": {"organizationType": "claude_max"}},
     "installed": {"plan": "pro", "plugin_version": "3.1.0"},
     "expect": {"status": "drift", "plan": "max", "render": "installer", "command_has": "npx riskrails@3.1.0 --target claude --plan max --yes"}}
  ]
}
