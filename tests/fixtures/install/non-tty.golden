{
  "inherits": null,
  "plan": "pro",
  "label": "Pro",
  "runtime": "claude",
  "economy": {
    "autoCompactWindow": 300000
  },
  "tiers": {
    "FAST": {
      "model": "haiku",
      "effort": "low",
      "agents": [
        "Explore",
        "log-reader"
      ]
    },
    "BALANCED": {
      "model": "sonnet",
      "effort": "medium",
      "agents": [
        "ai-discovery"
      ]
    },
    "STRONG": {
      "model": "opus",
      "effort": "high",
      "agents": [
        "ai-reviewer"
      ]
    },
    "EXPERT": {
      "model": "opus",
      "effort": "high",
      "agents": [
        "architect"
      ]
    }
  },
  "budgets": {
    "expert": {
      "without_asking": false,
      "max_per_task": 1
    },
    "tokens": {
      "unit": "total_tokens_millions",
      "per_task": {
        "T0": 0.2,
        "T1": 0.4,
        "T2": 1,
        "T3": 3,
        "T4": 5,
        "T5": 8
      }
    }
  },
  "preferred_runtime": {
    "default": "same",
    "by_workflow": {
      "refactoring": "codex"
    },
    "quota_pct": 90,
    "cross_vendor_review_from": "T4"
  },
  "fable": false,
  "context": {
    "mode": "default",
    "window": null
  },
  "plugin_version": "<VERSION>",
  "written_at": "<TIME>",
  "dialog": {
    "tool": "AskUserQuestion"
  },
  "set_by": {
    "via": "installer",
    "at": "<TIME>"
  }
}
