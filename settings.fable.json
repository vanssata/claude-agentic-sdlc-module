{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/fable-gate.py\"",
            "timeout": 5,
            "statusMessage": "Checking Fable availability"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/fable-gate.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": "rate_limit|model_not_found",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/fable-gate.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
