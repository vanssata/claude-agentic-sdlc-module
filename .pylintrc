# Pylint for the plugin's hook and helper scripts.
# The house style is deliberately compact: short one-line helpers, %-formatting,
# long aligned comment columns, few docstrings. Convention (C) and design-limit
# checks fight that style, so they are off. Errors, warnings and the remaining
# refactor checks stay on; a warning that is intentional is disabled inline
# with its reason.

[MAIN]
py-version=3.11

[MESSAGES CONTROL]
disable=
    C,
    too-many-locals,
    too-many-branches,
    too-many-statements,
    too-many-arguments,
    too-many-positional-arguments,
    too-many-instance-attributes,
    too-many-return-statements,
    too-many-nested-blocks,
    too-many-boolean-expressions,
    too-few-public-methods,
    use-dict-literal,
    # runtime-gate.py is a standalone hook for two runtimes and must run as a single
    # file; fable-gate.py and codex-model-gate.py are shims that exec it.
    duplicate-code,

[REFACTORING]
# die() prints and calls sys.exit(1)
never-returning-functions=sys.exit,argparse.parse_error,state.die
