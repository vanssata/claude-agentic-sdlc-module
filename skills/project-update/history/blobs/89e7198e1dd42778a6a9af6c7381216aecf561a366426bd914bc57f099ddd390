# Project-scoped Codex configuration for {{PROJECT}}.
#
# This layer is loaded only when the project is trusted. Put here what belongs to
# the repository rather than to the machine: per-project agent limits, project
# MCP servers, project hooks. Host-wide routing stays in ~/.codex/config.toml.
#
# Example — cap the agent fan-out for a small repository:
#
#   [agents]
#   max_concurrent_threads_per_session = 4
