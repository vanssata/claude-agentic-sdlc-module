{"version": 1,
 "tools": {
  "speckit": {"signature": [".specify/"],
              "roots": [".specify/", "specs/",
                        ".claude/commands/speckit*", ".claude/skills/speckit-*",
                        ".github/prompts/speckit*", ".github/skills/speckit-*", ".github/agents/speckit*",
                        ".codex/prompts/speckit*", ".agents/skills/speckit-*",
                        ".gemini/commands/speckit*",
                        ".cursor/commands/speckit*", ".cursor/skills/speckit-*"]},
  "kiro":    {"signature": [".kiro/"], "roots": [".kiro/"]},
  "aidlc":   {"signature": ["aidlc-docs/"],
              "roots": ["aidlc-docs/", ".amazonq/rules/aws-aidlc-rules/", ".amazonq/aws-aidlc-rule-details/"]},
  "cursor":  {"signature": [".cursorrules", ".cursor/rules/"], "roots": [".cursorrules", ".cursor/"]},
  "copilot": {"signature": [".github/copilot-instructions.md", ".github/instructions/"],
              "roots": [".github/copilot-instructions.md", ".github/instructions/"]},
  "junie":   {"signature": [".junie/guidelines.md"], "roots": []},
  "gemini":  {"signature": ["GEMINI.md"], "roots": []},
  "claude":  {"signature": ["CLAUDE.md"], "roots": []},
  "codex":   {"signature": ["AGENTS.md"], "roots": []}
 },
 "own": {
  "_doc": "setup.py survey|adopt: a project's own toolbox, inventoried in place (SQ5) — never copied, never moved; update.py --adopt does not read this key",
  "inventory": [
   {"glob": ".claude/skills/*/SKILL.md", "kind": "skill", "router": "skill"},
   {"glob": ".claude/commands/**/*.md", "kind": "command", "router": "command"},
   {"glob": ".claude/rules/**/*.md", "kind": "rule"},
   {"glob": ".claude/agents/*.md", "kind": "agent"},
   {"glob": ".claude/hooks/*", "kind": "hook"},
   {"glob": ".agents/skills/*/SKILL.md", "kind": "skill", "router": "skill"},
   {"glob": ".codex/skills/*/SKILL.md", "kind": "skill", "router": "skill"},
   {"glob": ".codex/prompts/*.md", "kind": "command", "router": "command"},
   {"glob": ".codex/agents/*", "kind": "agent"},
   {"glob": ".codex/hooks/*", "kind": "hook"},
   {"glob": "bin/*.sh", "kind": "script"},
   {"glob": "Makefile", "kind": "make"}
  ],
  "guards": {
   "ai-git-guard": ["git", "commit", "push", "merge"],
   "ai-path-guard": ["path", "protect", "protected", "secret", "secrets", "dotenv"],
   "ai-scope-guard": ["scope"]
  },
  "verify": [
   {"file": "Makefile", "make_target": ["test", "tests", "check", "qa"], "command": "make {name}"},
   {"file": "composer.json", "script": ["test", "tests", "qa", "check"], "command": "composer {name}"},
   {"file": "package.json", "script": ["test"], "command": "npm test"},
   {"file": "bin/*.sh", "stem": ["test", "tests", "run-tests", "check"], "command": "bin/{name}.sh"},
   {"file": "phpunit.xml.dist", "command": "vendor/bin/phpunit"},
   {"file": "phpunit.xml", "command": "vendor/bin/phpunit"},
   {"file": "pytest.ini", "command": "python3 -m pytest"}
  ]
 },
 "rows": [
  {"tool":"speckit","source":".specify/memory/constitution.md","dest":"docs/sdlc/constitution.md","transform":"append-section","cleanup":true},
  {"tool":"speckit","source":"specs/*/spec.md","dest":"docs/sdlc/specs/{dir}.md","transform":"copy","cleanup":true,"router":"an adopted Spec Kit spec"},
  {"tool":"speckit","source":"specs/*/plan.md","dest":"docs/sdlc/plans/{dir}.md","transform":"copy","cleanup":true,"router":"an adopted Spec Kit plan"},
  {"tool":"speckit","source":"specs/*/tasks.md","dest":"docs/sdlc/plans/{dir}-tasks.md","transform":"copy","cleanup":true},
  {"tool":"speckit","source":"specs/*/*.md","dest":"docs/sdlc/specs/{dir}-{stem}.md","transform":"copy","cleanup":true},
  {"tool":"speckit","source":"specs/*/checklists/*.md","dest":"docs/sdlc/specs/{rel}.md","transform":"copy","cleanup":true},
  {"tool":"speckit","source":".specify/templates/**","transform":"drop","why":"Spec Kit templates; docs/sdlc/*/TEMPLATE.md replace them","cleanup":true},
  {"tool":"speckit","source":".specify/scripts/**","transform":"drop","why":"Spec Kit tool machinery; the skills replace it","cleanup":true},
  {"tool":"speckit","source":".specify/extensions/**","transform":"drop","why":"Spec Kit tool machinery; the skills replace it","cleanup":true},
  {"tool":"speckit","source":".specify/presets/**","transform":"drop","why":"Spec Kit tool machinery; the skills replace it","cleanup":true},
  {"tool":"speckit","source":".specify/workflows/**","transform":"drop","why":"Spec Kit tool machinery; the skills replace it","cleanup":true},
  {"tool":"speckit","source":".specify/integrations/**","transform":"drop","why":"Spec Kit tool machinery; the skills replace it","cleanup":true},
  {"tool":"speckit","source":".specify/*.json","transform":"drop","why":"Spec Kit tool machinery; the skills replace it","cleanup":true},
  {"tool":"speckit","source":".specify/extensions.yml","transform":"drop","why":"Spec Kit tool machinery; the skills replace it","cleanup":true},
  {"tool":"speckit","source":"*/**/speckit*","transform":"drop","why":"Spec Kit agent commands; they call .specify/ and the sdlc skills replace them","cleanup":true},
  {"tool":"speckit","source":"*/**/speckit-*/**","transform":"drop","why":"Spec Kit agent skills; they call .specify/ and the sdlc skills replace them","cleanup":true},
  {"tool":"kiro","source":".kiro/steering/aws-aidlc-rules/**","transform":"ignore","why":"the AI-DLC methodology installed for Kiro, not project knowledge; kept in place"},
  {"tool":"kiro","source":".kiro/aws-aidlc-rule-details/**","transform":"ignore","why":"the AI-DLC methodology installed for Kiro, not project knowledge; kept in place"},
  {"tool":"kiro","source":".kiro/steering/*.md","dest":"auto","transform":"rule","cleanup":true,"frontmatter":{"paths":"fileMatchPattern","always":"inclusion=always","always_when_absent":true}},
  {"tool":"kiro","source":".kiro/specs/*/requirements.md","dest":"docs/sdlc/intent/{dir}.md","transform":"copy","cleanup":true,"router":"an adopted Kiro requirement"},
  {"tool":"kiro","source":".kiro/specs/*/design.md","dest":"docs/sdlc/specs/{dir}.md","transform":"copy","cleanup":true},
  {"tool":"kiro","source":".kiro/specs/*/tasks.md","dest":"docs/sdlc/plans/{dir}.md","transform":"copy","cleanup":true},
  {"tool":"kiro","source":".kiro/settings/**","transform":"ignore","why":"Kiro tool configuration"},
  {"tool":"aidlc","source":"aidlc-docs/aidlc-state.md","transform":"drop","why":"AI-DLC workflow tracker; .ai/state/ replaces it","cleanup":true},
  {"tool":"aidlc","source":"aidlc-docs/audit.md","transform":"ignore","why":"AI-DLC audit trail; history, kept in place"},
  {"tool":"aidlc","source":"aidlc-docs/inception/**/*.md","dest":"docs/sdlc/intent/aidlc-{rel}.md","transform":"copy","cleanup":true},
  {"tool":"aidlc","source":"aidlc-docs/construction/**/*.md","dest":"docs/sdlc/plans/aidlc-{rel}.md","transform":"copy","cleanup":true},
  {"tool":"aidlc","source":".amazonq/rules/aws-aidlc-rules/**","transform":"ignore","why":"the AI-DLC methodology, not project knowledge; kept in place"},
  {"tool":"aidlc","source":".amazonq/aws-aidlc-rule-details/**","transform":"ignore","why":"the AI-DLC methodology, not project knowledge; kept in place"},
  {"tool":"cursor","source":".cursorrules","dest":".ai/policies/adopted/cursorrules.md","transform":"copy","cleanup":true,"router":"anything, first (rules adopted from Cursor)"},
  {"tool":"cursor","source":".cursor/rules/**/*.mdc","dest":"auto","transform":"rule","cleanup":true,"frontmatter":{"paths":"globs","always":"alwaysApply=true","title":"description"}},
  {"tool":"cursor","source":".cursor/*","transform":"ignore","why":"Cursor tool configuration (mcp.json and the like)"},
  {"tool":"copilot","source":".github/copilot-instructions.md","dest":".ai/policies/adopted/copilot-instructions.md","transform":"copy","cleanup":true,"router":"anything, first (rules adopted from Copilot)"},
  {"tool":"copilot","source":".github/instructions/*.instructions.md","dest":"auto","transform":"rule","cleanup":true,"frontmatter":{"paths":"applyTo","title":"description"}},
  {"tool":"junie","source":".junie/guidelines.md","transform":"instruction-file","cleanup":false},
  {"tool":"gemini","source":"GEMINI.md","transform":"instruction-file","cleanup":false},
  {"tool":"claude","source":"CLAUDE.md","transform":"instruction-file","cleanup":false},
  {"tool":"codex","source":"AGENTS.md","transform":"instruction-file","cleanup":false}
 ]}
