#!/usr/bin/env bash
# claude-1m — one Claude Code session on a 1m-context model with its own compaction window.
#
#   claude-1m [opus|fable] [any claude argument]
#
#   claude-1m                    Opus 5 [1m] as the main session
#   claude-1m fable              Fable 5.1 [1m] as the main session
#   claude-1m fable -p '<brief>' one headless large-context run, e.g. called from another session
#   CLAUDE_1M_COMPACT_WINDOW=500000 claude-1m     # compact earlier than the runtime would
#
# This launcher is about the model, not the window: it pins a [1m] model for one
# session at launch, and by default leaves compaction to Claude Code (or to the
# `autoCompactWindow` of an install with `--context economy`, which Claude Code caps at
# the model's own window: 800 000 means near 167k on `opus` and near 767k on `opus[1m]`).
# Only CLAUDE_1M_COMPACT_WINDOW sets a window: exported as CLAUDE_CODE_AUTO_COMPACT_WINDOW,
# it outranks settings.json for this process only. context-guard reads the same
# variable, so its warning and hold-back thresholds follow.
#
# Subagents get the session's window, capped by Claude Code at each model's own: a 200k
# agent compacts near 167k, and `architect` on fable[1m] gets the full window.
#
# The `fable` alias is Fable 5.1 (claude-fable-5-1) on the Anthropic API, not Fable 5.
set -euo pipefail

MODEL='opus[1m]'
case "${1:-}" in
  opus)  shift;;
  fable) MODEL='fable[1m]'; shift;;
esac

if [ -n "${CLAUDE_1M_COMPACT_WINDOW:-}" ]; then
  WINDOW="$CLAUDE_1M_COMPACT_WINDOW"
  case "$WINDOW" in
    ''|*[!0-9]*) echo "claude-1m: CLAUDE_1M_COMPACT_WINDOW must be a number of tokens (got '$WINDOW')" >&2; exit 2;;
  esac
  export CLAUDE_CODE_AUTO_COMPACT_WINDOW="$WINDOW"
fi
exec "${CLAUDE_BIN:-claude}" --model "$MODEL" "$@"
