{
  "_comment": "Shipped defaults for ai-path-guard.sh. Do not edit this file; a project overrides it in .ai/policies/path-guard.json (patterns are unioned, allow wins over deny). Patterns are POSIX extended regular expressions matched against the absolute path. The protected_config_patterns cover both runtimes: an agent may not edit the guards' own configuration under .claude/hooks/ or .codex/hooks/, in a project or in the user's home.",
  "deny_patterns": [
    "(^|/)\\.env$",
    "(^|/)\\.env\\.(local|prod|production|staging|live)$",
    "(^|/)secrets?/",
    "(^|/)credentials?/",
    "(^|/)\\.ssh/",
    "(^|/)id_(rsa|dsa|ecdsa|ed25519)$",
    "\\.(pem|p12|pfx|jks|keystore)$",
    "(^|/)\\.aws/credentials$",
    "(^|/)\\.docker/config\\.json$",
    "(^|/)(kubeconfig|\\.kube/config)$",
    "(dump|backup|export)s?[-_.].*\\.(sql|sql\\.gz|sql\\.bz2|csv|xlsx)$",
    ".*\\.(sql|sql\\.gz)$",
    "(^|/)var/log/.*(prod|production).*\\.log$",
    "(^|/)auth\\.json$"
  ],
  "allow_patterns": [
    "\\.env\\.(dist|example|sample|test|template)$",
    "(^|/)secrets?/.*\\.(md|dist|example|template)$",
    "(^|/)migrations?/.*\\.(sql|php)$",
    "(^|/)tests?/.*\\.sql$",
    "(^|/)fixtures?/.*\\.(sql|csv)$"
  ],
  "protected_config_patterns": [
    "(^|/)\\.ai/state/[^/]*\\.json$",
    "(^|/)\\.ai/policies/[^/]*\\.json$",
    "(^|/)\\.claude/hooks/ai-[^/]*$",
    "/\\.claude/hooks/ai-[^/]*$",
    "(^|/)\\.codex/hooks/ai-[^/]*$",
    "/\\.codex/hooks/ai-[^/]*$",
    "(^|/)\\.codex/hooks/codex-model-gate\\.py$"
  ]
}
