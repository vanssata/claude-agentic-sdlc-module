{
  "_comment": "Shipped defaults for ai-path-guard.sh. Do not edit this file; a project overrides it in .ai/policies/path-guard.json (patterns are unioned, allow wins over every other list). Patterns are POSIX extended regular expressions matched against the absolute path. protected_config_patterns cover both runtimes and are always on: an agent may not edit the guards' own configuration under .claude/hooks/ or .codex/hooks/, in a project or in the user's home. task_protected_patterns are on only while an /ai-task run is in flight (.ai/state/current.json exists and has not reached \"done\"): they freeze the runtime's settings, agents, skills, commands, hooks and the pipeline's own policies and workflows, so a run cannot change the rules it is being judged by. Reading either is allowed; writing is not. dependency_instruction_patterns are always on and refuse both read and write: an instruction file that arrived with a package is third-party data, not an instruction, and the next install overwrites it anyway.",
  "deny_patterns": [
    "(^|/)\\.env$",
    "(^|/)\\.env\\.(local|prod|production|staging|live)$",
    "(^|/)secrets?/",
    "(^|/)credentials?/",
    "(^|/)\\.ssh/",
    "(^|/)id_(rsa|dsa|ecdsa|ed25519)$",
    "\\.(pem|p12|pfx|jks|keystore)$",
    "(^|/)\\.aws/credentials$",
    "(^|/)\\.docker/config\\.json$",
    "(^|/)(kubeconfig|\\.kube/config)$",
    "(dump|backup|export)s?[-_.].*\\.(sql|sql\\.gz|sql\\.bz2|csv|xlsx)$",
    ".*\\.(sql|sql\\.gz)$",
    "(^|/)var/log/.*(prod|production).*\\.log$",
    "(^|/)auth\\.json$"
  ],
  "allow_patterns": [
    "\\.env\\.(dist|example|sample|test|template)$",
    "(^|/)secrets?/.*\\.(md|dist|example|template)$",
    "(^|/)migrations?/.*\\.(sql|php)$",
    "(^|/)tests?/.*\\.sql$",
    "(^|/)fixtures?/.*\\.(sql|csv)$"
  ],
  "protected_config_patterns": [
    "(^|/)\\.ai/state/[^/]*\\.json$",
    "(^|/)\\.ai/state/handoff\\.md$",
    "(^|/)\\.ai/reports/[^/]+/questions\\.md$",
    "(^|/)\\.ai/reports/[^/]+/events\\.jsonl$",
    "(^|/)\\.ai/policies/[^/]*\\.json$",
    "(^|/)\\.claude/hooks/ai-[^/]*$",
    "/\\.claude/hooks/ai-[^/]*$",
    "(^|/)\\.codex/hooks/ai-[^/]*$",
    "/\\.codex/hooks/ai-[^/]*$",
    "(^|/)\\.codex/hooks/codex-model-gate\\.py$"
  ],
  "task_protected_patterns": [
    "(^|/)\\.claude/settings[^/]*\\.json$",
    "(^|/)\\.claude/(agents|skills|commands|hooks|plugins)/",
    "(^|/)\\.claude/CLAUDE\\.md$",
    "(^|/)\\.codex/config\\.toml$",
    "(^|/)\\.codex/(agents|skills|prompts|hooks)/",
    "(^|/)\\.codex/AGENTS\\.md$",
    "(^|/)\\.ai/(AGENTS\\.md|CLAUDE\\.md)$",
    "(^|/)\\.ai/(policies|workflows|templates)/",
    "(^|/)\\.github/copilot-instructions\\.md$",
    "(^|/)\\.junie/guidelines\\.md$",
    "(^|/)\\.cursor/rules/",
    "(^|/)\\.cursorrules$",
    "(^|/)\\.ai/rules/",
    "(^|/)\\.claude/rules/",
    "(^|/)docs/sdlc/constitution\\.md$"
  ],
  "dependency_instruction_patterns": [
    "(^|/)(vendor|node_modules|bower_components|third_party|Pods|site-packages|\\.venv|\\.pnpm|\\.yarn)/(.*/)?(CLAUDE|AGENTS|GEMINI|CONVENTIONS)\\.md$",
    "(^|/)(vendor|node_modules|bower_components|third_party|Pods|site-packages|\\.venv|\\.pnpm|\\.yarn)/(.*/)?\\.(cursorrules|windsurfrules|clinerules|aiderrules)$",
    "(^|/)(vendor|node_modules|bower_components|third_party|Pods|site-packages|\\.venv|\\.pnpm|\\.yarn)/(.*/)?\\.cursor/rules/",
    "(^|/)(vendor|node_modules|bower_components|third_party|Pods|site-packages|\\.venv|\\.pnpm|\\.yarn)/(.*/)?\\.github/copilot-instructions\\.md$",
    "(^|/)(vendor|node_modules|bower_components|third_party|Pods|site-packages|\\.venv|\\.pnpm|\\.yarn)/(.*/)?\\.junie/guidelines\\.md$",
    "(^|/)(vendor|node_modules|bower_components|third_party|Pods|site-packages|\\.venv|\\.pnpm|\\.yarn)/(.*/)?\\.claude/(agents|skills|commands|hooks)/"
  ]
}
