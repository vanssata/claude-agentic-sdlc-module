{
  "_comment": "Shipped defaults for ai-git-guard.sh. The installer copies this to the hooks directory of each runtime it installs — ~/.claude/hooks/ai-git-guard.json, ~/.codex/hooks/ai-git-guard.json — once, and never overwrites it, so local edits survive a re-install. Each runtime therefore has its own copy; edit both if you want the same local rule in both. This guard is global: it applies in every repository, whether or not the project uses .ai/, and under Codex it sees the shell tool under its own name as well.",
  "protected_branches": ["main", "master", "production", "prod", "stable", "release/.*", "hotfix/.*"],
  "deploy_patterns": [
    "(^|[|;&[:space:]])argocd[[:space:]]+app[[:space:]]+(sync|rollback|delete)",
    "(^|[|;&[:space:]])helm[[:space:]]+(upgrade|install|rollback|uninstall|delete)([[:space:]]+[^;&|[:space:]]+)*[[:space:]]+.*(prod|production|live)",
    "(^|[|;&[:space:]])kubectl[[:space:]]+.*--context[[:space:]]*=?[^[:space:]]*(prod|production|live)",
    "(^|[|;&[:space:]])kubectl[[:space:]]+(delete|drain|cordon)[[:space:]]+(namespace|node|deployment)",
    "(^|[|;&[:space:]])(dep|deployer)[[:space:]]+deploy[[:space:]]+prod",
    "(^|[|;&[:space:]])(cap|bundle[[:space:]]+exec[[:space:]]+cap)[[:space:]]+production[[:space:]]+deploy",
    "(^|[|;&[:space:]])terraform[[:space:]]+(apply|destroy)",
    "(^|[|;&[:space:]])(flyctl|fly)[[:space:]]+deploy",
    "(^|[|;&[:space:]])(vercel|netlify)[[:space:]]+(deploy|--prod)"
  ],
  "sensitive_staging_patterns": [
    "(^|/)\\.env$",
    "(^|/)\\.env\\.(local|prod|production|staging|live)$",
    "(^|/)secrets?/",
    "(^|/)credentials?/",
    "(^|/)id_(rsa|dsa|ecdsa|ed25519)$",
    "\\.(pem|p12|pfx|jks|keystore)$",
    "(^|/)\\.aws/credentials$",
    "(^|/)auth\\.json$",
    "(dump|backup|export)s?[-_.].*\\.(sql|sql\\.gz|csv)$"
  ],
  "allow_force_push_repos": [],
  "allow_protected_push_repos": []
}
